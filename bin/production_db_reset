#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

# Kamal은 기본적으로 커밋된 코드를 빌드한다.
# 수정한 코드가 빠진 이미지로 초기화하지 않도록 확인한다.
if [[ -n "$(git status --porcelain)" ]]; then
  echo "먼저 변경 사항을 커밋해주세요."
  exit 1
fi

deploy_version="$(git rev-parse HEAD)"

# 앱을 멈추기 전에 현재 커밋의 이미지를 빌드하고 서버에 내려받는다.
echo "Building and delivering image: ${deploy_version}"
bin/kamal build deliver --version="$deploy_version"

echo "Stopping the production app..."
bin/kamal app stop

# 운영 데이터를 전부 삭제하고, 동일한 이미지의 마이그레이션으로 재생성한다.
echo "Resetting production databases..."
bin/kamal app exec \
  --version="$deploy_version" \
  --env=DISABLE_DATABASE_ENVIRONMENT_CHECK:1 \
  bin/rails db:migrate:reset

echo "Seeding production databases..."
bin/kamal app exec \
  --version="$deploy_version" \
  bin/rails db:seed

# start는 기존 컨테이너를 켜므로, 지정한 이미지로 실행하는 boot를 사용한다.
echo "Booting production app: ${deploy_version}"
bin/kamal app boot --version="$deploy_version"

echo "Production reset completed: ${deploy_version}"