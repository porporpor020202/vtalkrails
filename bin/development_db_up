#!/bin/bash
set -e

# Start Docker Desktop and wait for its engine before starting PostgreSQL.
if ! docker info >/dev/null 2>&1; then
  echo "Starting Docker Desktop..."
  docker desktop start --timeout 120
  docker info >/dev/null
fi

# Reuse the shared PostgreSQL container without recreating it or its volume.
docker start local-postgres

for ((attempt = 0; attempt < 30; attempt++)); do
  if docker exec local-postgres pg_isready -q; then
    exit 0
  fi
  sleep 2
done

echo "PostgreSQL did not become ready within 60 seconds." >&2
exit 1
