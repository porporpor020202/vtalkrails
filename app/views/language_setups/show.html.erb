<% content_for :title, "Languages" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <%= link_to settings_path, class: "inline-flex items-center gap-1 text-sm font-semibold text-slate-500" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-7 7 7 7" />
      </svg>
      Setting
    <% end %>
    <h1 class="mt-2 text-3xl font-black tracking-[-0.035em] text-slate-950">Languages</h1>
  </header>

  <%= form_with model: @user, url: language_setup_path, method: :patch,
        data: { controller: "onboarding-languages", action: "submit->onboarding-languages#validate" },
        class: "space-y-6 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm" do |form| %>
    <div>
      <%= form.label :learning_language_id, "Learning language",
            class: "mb-2 block text-sm font-semibold text-indigo-600" %>
      <%= form.collection_select :learning_language_id, Language.enabled.order(:label), :id, :label,
            { include_blank: "Select your learning language", disabled: [@user.native_language_id] },
            data: { onboarding_languages_target: "learning" },
            class: "h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base text-slate-950" %>
    </div>

    <div>
      <%= form.label :native_language_id, "Native language",
            class: "mb-2 block text-sm font-semibold text-slate-500" %>
      <%= form.collection_select :native_language_id, Language.enabled.order(:label), :id, :label,
            { include_blank: "Select your native language" },
            data: { onboarding_languages_target: "native", action: "change->onboarding-languages#sync" },
            class: "h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base text-slate-950" %>
    </div>
    <p class="text-sm text-slate-500">
      Your native language and learning language cannot be the same.
    </p>

    <%= form.submit "Save changes",
          class: "h-14 w-full cursor-pointer rounded-2xl bg-slate-900 font-semibold text-white",
          data: { turbo_submits_with: "Saving..." } %>
  <% end %>
</section>
