<% content_for :title, "Choose your languages" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Choose your languages</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">Select your mother language and a different language you want to learn to get started.</p>
  </header>

  <%= render "shared/language_form", destination: language_setup_path, submit_label: "Continue" %>

  <%= button_to "Sign Out", session_path, method: :delete, class: "mt-6 w-full py-3 text-sm font-semibold text-slate-500" %>
</section>
