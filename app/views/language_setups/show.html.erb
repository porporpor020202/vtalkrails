<% content_for :title, "Native language" %>

<section class="settings-page settings-detail">
  <header class="settings-header">
    <p>Preferences</p>
    <h1>Native language</h1>
  </header>

  <%= form_with model: @user, url: language_setup_path, method: :patch,
        data: { controller: "native-language", action: "submit->native-language#validate" },
        class: "settings-form" do |form| %>
    <% if @user.errors.any? %>
      <div role="alert" class="rounded-2xl bg-red-50 p-4 text-sm text-red-700">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :native_language_id, "Native language",
            class: "settings-label" %>
      <%= form.collection_select :native_language_id, Language.enabled.order(:label), :id, :label,
            { include_blank: "Select your native language" },
            data: { native_language_target: "select" },
            class: "settings-input" %>
    </div>

    <%= form.submit "Save changes",
          class: "settings-button",
          data: { turbo_submits_with: "Saving..." } %>

    <dialog data-native-language-target="dialog"
            aria-label="Language selection"
            aria-describedby="language-selection-message"
            class="settings-dialog">
      <p id="language-selection-message" class="text-sm text-slate-700">
        Please select your native language.
      </p>
      <button type="button" autofocus
              data-action="native-language#closeDialog"
              class="settings-button mt-5">
        OK
      </button>
    </dialog>
  <% end %>
</section>
