<% content_for :title, admin ? "Admin feedback" : "Feedback" %>

<section class="flex min-h-full flex-col bg-slate-50 px-5 py-6">
  <%= link_to "Back to settings", settings_path, class: "mb-5 text-sm font-semibold text-indigo-600" %>
  <header class="mb-6">
    <h1 class="text-3xl font-black tracking-tight text-slate-950"><%= admin ? "All feedback" : "Feedback" %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= admin ? "Read and respond to your users." : "We’d love to hear your feedback. The developer personally responds to every message within 48 hours." %></p>
  </header>

  <% unless admin %>
    <%= link_to "New feedback", new_feedback_path, class: "mb-6 rounded-2xl bg-indigo-600 px-5 py-3 text-center text-sm font-bold text-white" %>
  <% end %>

  <div class="space-y-3">
    <% feedbacks.each do |feedback| %>
      <%= link_to admin ? admin_feedback_path(feedback) : feedback_path(feedback), class: "block rounded-2xl border border-slate-200 bg-white p-5" do %>
        <h2 class="break-words font-bold text-slate-950"><%= feedback.title %></h2>
        <p class="mt-2 text-xs text-slate-500">
          <% if admin %><%= feedback.user.display_name %> · <% end %>
          <%= feedback.created_at.strftime("%Y-%m-%d %H:%M") %>
        </p>
      <% end %>
    <% end %>
    <% if feedbacks.empty? %>
      <p class="rounded-2xl border border-dashed border-slate-300 px-5 py-10 text-center text-sm text-slate-500">No feedback yet.</p>
    <% end %>
  </div>
</section>
