<% content_for :title, admin ? "Admin feedback" : "Feedback" %>

<section class="<%= admin ? "flex min-h-full flex-col bg-slate-50 px-5 py-6" : "settings-page settings-detail" %>">
  <header class="<%= admin ? "mb-6" : "settings-header" %>">
    <% unless admin %><p class="settings-eyebrow">Support</p><% end %>
    <h1 class="<%= admin ? "text-3xl font-black tracking-tight text-slate-950" : "settings-heading" %>"><%= admin ? "All feedback" : "Feedback" %></h1>
    <p class="<%= admin ? "mt-2 text-sm text-slate-500" : "settings-copy" %>"><%= admin ? "Read and respond to your users." : "We’d love to hear your feedback. The developer personally responds to every message within 48 hours." %></p>
  </header>

  <% unless admin %>
    <%= link_to "New feedback", new_feedback_path, class: "settings-button settings-new-feedback" %>
  <% end %>

  <div class="<%= admin ? "space-y-3" : "settings-feedback-list" %>">
    <% feedbacks.each do |feedback| %>
      <%= link_to admin ? admin_feedback_path(feedback) : feedback_path(feedback), class: admin ? "block rounded-2xl border border-slate-200 bg-white p-5" : "settings-feedback-row" do %>
        <h2 class="<%= admin ? "break-words font-bold text-slate-950" : "settings-feedback-title" %>"><%= feedback.title %></h2>
        <p class="<%= admin ? "mt-2 text-xs text-slate-500" : "settings-meta" %>">
          <% if admin %><%= feedback.user.display_name %> · <% end %>
          <%= feedback.created_at.strftime("%Y-%m-%d %H:%M") %>
        </p>
      <% end %>
    <% end %>
    <% if feedbacks.empty? %>
      <p class="<%= admin ? "rounded-2xl border border-dashed border-slate-300 px-5 py-10 text-center text-sm text-slate-500" : "settings-empty" %>">No feedback yet.</p>
    <% end %>
  </div>
</section>
