<%= form_with model: feedback, class: "settings-form" do |form| %>
  <% if feedback.errors.any? %>
    <div role="alert" class="rounded-2xl bg-rose-50 p-4 text-sm text-rose-700"><%= feedback.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= form.label :title, "Title", class: "settings-label" %>
    <%= form.text_field :title, required: true, class: "settings-input" %>
  </div>
  <div>
    <%= form.label :body, "Message", class: "settings-label" %>
    <%= form.text_area :body, required: true, rows: 7, class: "settings-input" %>
  </div>
  <%= form.submit feedback.persisted? ? "Save changes" : "Send feedback", class: "settings-button" %>
<% end %>
