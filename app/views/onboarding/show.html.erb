<% content_for :title, "Complete your profile | Say One Thing" %>
<% content_for :hide_bottom_nav, "true" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="flex flex-1 items-center px-6 py-10" data-controller="auth-history" data-action="pageshow@window->auth-history#restore">
  <section class="w-full">
    <%= form_with model: @user, url: onboarding_path, method: :patch, class: "mt-8 space-y-5", data: { controller: "onboarding-languages", action: "submit->onboarding-languages#validate" } do |form| %>
      <% if @user.errors.any? %>
        <p role="alert" class="text-sm text-rose-600"><%= @user.errors.full_messages.to_sentence %></p>
      <% end %>
      <% languages = Language.enabled.order(:label) %>

      <%# TODO: collection_select 공식문서 참조하자. %>
      <%= form.collection_select :native_language_id, languages, :id, :label,
            { prompt: "Select your native language" },
            { required: true,
              data: { onboarding_languages_target: "native", action: "change->onboarding-languages#sync" },
              class: "h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base text-slate-900" } %>

      <p data-onboarding-languages-target="nativeGuidance" class="text-sm text-slate-500">Please select your native language.</p>

      <button type="button" data-action="onboarding-languages#requestMicrophone" class="h-14 w-full rounded-2xl border border-slate-300 bg-white font-semibold text-slate-900">
        Allow microphone
      </button>

      <p role="status" data-onboarding-languages-target="microphoneStatus" class="text-sm text-slate-500">Microphone access is denied. Please enable microphone access.</p>

      <%= form.hidden_field :microphone_confirmed, value: "0", data: { onboarding_languages_target: "microphoneConfirmed" } %>
      <%= form.label :date_of_birth, "Date of birth", class: "block text-sm font-semibold" %>
      <%= form.text_field :date_of_birth, required: true, placeholder: "YYYY-MM-DD", autocomplete: "bday", inputmode: "numeric", maxlength: 10, class: "h-14 w-full rounded-2xl border border-slate-300 px-4", data: { onboarding_languages_target: "birthday", action: "input->onboarding-languages#formatBirthday change->onboarding-languages#sync" } %>
      <p data-onboarding-languages-target="ageGuidance" class="text-sm text-slate-500">Please enter your date of birth.</p>

      <label class="flex items-start gap-3 text-sm leading-6 text-slate-700">
        <%= form.check_box :community_rules_accepted, required: true, class: "mt-1 h-5 w-5 shrink-0", data: { onboarding_languages_target: "rules", action: "change->onboarding-languages#sync" } %>
        <span>I agree to the <%= link_to "Community Rules and Terms of Use", community_rules_path, class: "font-semibold underline underline-offset-2", target: "_blank", rel: "noopener" %>, including the prohibition of abusive content and conduct.</span>
      </label>

      <%= form.submit "Continue",
            disabled: true,
            class: "h-14 w-full cursor-pointer rounded-2xl bg-slate-900 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50",
            data: { onboarding_languages_target: "continue", turbo_submits_with: "Saving..." } %>
    <% end %>

    <%= button_to "Sign Out", session_path, method: :delete,
          class: "mt-4 h-12 w-full cursor-pointer rounded-2xl bg-rose-50 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>

  </section>
</div>
