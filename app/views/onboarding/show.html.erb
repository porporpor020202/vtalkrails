<% content_for :title, "Complete your profile | Say One Thing" %>
<% content_for :hide_bottom_nav, "true" %>

<div class="flex flex-1 items-center px-6 py-10">
  <section class="w-full">
    <%= form_with model: @user, url: onboarding_path, method: :patch, class: "mt-8 space-y-5", data: { controller: "onboarding-languages" } do |form| %>
      <% if @user.errors.any? %>
        <p role="alert" class="text-sm text-rose-600"><%= @user.errors.full_messages.to_sentence %></p>
      <% end %>
      <% languages = Language.enabled.order(:label) %>

      <%# TODO: collection_select 공식문서 참조하자. %>
      <%= form.collection_select :native_language_id, languages, :id, :label,
            { prompt: "Select your native language" },
            { required: true,
              data: { onboarding_languages_target: "native", action: "change->onboarding-languages#sync" },
              class: "h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base text-slate-900" } %>

      <%= form.collection_select :learning_language_id, languages, :id, :label,
            { prompt: "Select your learning language", disabled: [@user.native_language_id] },
            { required: true,
              data: { onboarding_languages_target: "learning" },
              class: "h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base text-slate-900" } %>

      <%= form.submit "Continue",
            class: "h-14 w-full cursor-pointer rounded-2xl bg-slate-900 font-semibold text-white",
            data: { turbo_submits_with: "Saving..." } %>
    <% end %>

    <%= button_to "Sign Out", session_path, method: :delete,
          class: "mt-4 h-12 w-full cursor-pointer rounded-2xl bg-rose-50 text-sm font-semibold text-rose-700 hover:bg-rose-100" %>

  </section>
</div>
