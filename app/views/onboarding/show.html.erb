<% content_for :title, "Welcome | Say One Thing" %>
<% content_for :hide_bottom_nav, true %>
<% content_for :hide_flash, true %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<section class="onboarding-page" data-controller="onboarding-languages auth-history" data-action="pageshow@window->auth-history#restore">
  <header class="onboarding-navigation">
    <button type="button" class="onboarding-back" data-action="onboarding-languages#back" aria-label="Back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg>
    </button>
    <div class="onboarding-progress" role="progressbar" aria-label="Onboarding progress" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" data-onboarding-languages-target="progress"><span data-onboarding-languages-target="progressFill"></span></div>
    <span class="onboarding-step-count" data-onboarding-languages-target="stepCount">1 / 5</span>
  </header>

  <%= form_with model: @user, url: onboarding_path, method: :patch, data: { action: "submit->onboarding-languages#validate", onboarding_languages_target: "form" } do |form| %>
    <% if @user.errors.any? %>
      <p role="alert" class="onboarding-error"><%= @user.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form.hidden_field :native_language_id, data: { onboarding_languages_target: "native" } %>
    <%= form.hidden_field :age_group, data: { onboarding_languages_target: "age" } %>
    <%= form.hidden_field :gender, data: { onboarding_languages_target: "gender" } %>
    <%= form.hidden_field :microphone_confirmed, value: "0", data: { onboarding_languages_target: "microphoneConfirmed" } %>
    <%= form.hidden_field :community_rules_accepted, value: "0", data: { onboarding_languages_target: "rules" } %>

    <section data-onboarding-languages-target="step" aria-labelledby="native-language-heading">
      <label class="onboarding-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="m15 15 6 6" /></svg>
        <span class="sr-only">Search languages</span>
        <input type="search" placeholder="Search" aria-label="Search languages" data-action="input->onboarding-languages#search">
      </label>
      <h1 id="native-language-heading" class="onboarding-title">Select your native language</h1>
      <div class="onboarding-options">
        <% flags = { "en" => "🇬🇧", "es" => "🇪🇸", "zh" => "🇨🇳", "ja" => "🇯🇵", "ko" => "🇰🇷" } %>
        <% Language.enabled.sort_by { |language| %w[en es zh ja].index(language.code) || 4 }.each do |language| %>
          <button type="button" class="onboarding-option" data-onboarding-languages-target="languageOption" data-action="onboarding-languages#chooseLanguage" data-value="<%= language.id %>" data-label="<%= language.label %>">
            <span class="onboarding-emoji" aria-hidden="true"><%= flags.fetch(language.code, "🌐") %></span><span><%= language.label %></span>
          </button>
        <% end %>
      </div>
      <p hidden class="onboarding-description" data-onboarding-languages-target="noResults">No languages found.</p>
    </section>

    <section hidden data-onboarding-languages-target="step" aria-labelledby="age-heading">
      <h1 id="age-heading" class="onboarding-title">How old are you?</h1>
      <div class="onboarding-options">
        <% User::AGE_GROUPS.each do |value, label| %>
          <button type="button" class="onboarding-option" data-action="onboarding-languages#chooseAge" data-value="<%= value %>"><%= label %></button>
        <% end %>
      </div>
      <p hidden role="alert" class="onboarding-error" data-onboarding-languages-target="ageError">You must be at least 18 years old to use Say One Thing.</p>
    </section>

    <section hidden data-onboarding-languages-target="step" aria-labelledby="gender-heading">
      <h1 id="gender-heading" class="onboarding-title">What is your gender?</h1>
      <div class="onboarding-options">
        <% User::GENDERS.each_with_index do |(value, label), index| %>
          <button type="button" class="onboarding-option" data-action="onboarding-languages#chooseGender" data-value="<%= value %>"><span class="onboarding-emoji" aria-hidden="true"><%= ["👨", "👩", "💬"][index] %></span><%= label %></button>
        <% end %>
      </div>
    </section>

    <section hidden data-onboarding-languages-target="step" aria-labelledby="microphone-heading">
      <div class="onboarding-microphone-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="9" y="3" width="6" height="12" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-3 0h6" /></svg></div>
      <h1 id="microphone-heading" class="onboarding-title">Let your voice in</h1>
      <p class="onboarding-description">Allow microphone access to record voice messages. Your microphone is only used when you choose to record.</p>
      <button type="button" class="onboarding-primary" data-action="onboarding-languages#requestMicrophone" data-onboarding-languages-target="microphoneButton">Allow microphone</button>
      <p class="onboarding-description" role="status" aria-live="polite" data-onboarding-languages-target="microphoneStatus"></p>
    </section>

    <section hidden data-onboarding-languages-target="step" aria-labelledby="rules-heading">
      <h1 id="rules-heading" class="onboarding-title">A space for real conversations</h1>
      <div class="onboarding-rules">
        <p>Be kind. Respect each other.</p>
        <p>Abusive, hateful, sexual, and other prohibited content or conduct has no place here. You can report or block anyone who makes you uncomfortable.</p>
        <p>By choosing “Agree and start”, you agree to our <%= link_to "Community Rules and Terms of Use", community_rules_path, target: "_blank", rel: "noopener" %>.</p>
        <%= link_to "Privacy Policy", privacy_path, target: "_blank", rel: "noopener" %>
      </div>
      <%= form.submit "Agree and start", class: "onboarding-primary", data: { onboarding_languages_target: "continue", turbo_submits_with: "Starting…" } %>
    </section>
  <% end %>
  <%= button_to session_path, method: :delete, form: { hidden: true, data: { onboarding_languages_target: "signOut" } } do %><span>Back to sign in</span><% end %>
</section>
