<% content_for :title, "Voice helper settings" %>
<% models = VoiceHelperSetting::MODELS.sort_by { |key, _model| @setting.monthly_cost_usd(key) } %>

<section class="space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">Voice helper settings</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Models & costs</h1>
    <p class="mt-2 text-sm text-slate-600">Choose the model for recorded speech to English. Changes apply to the next request.</p>
  </header>

  <% if @setting.errors.any? %>
    <p role="alert" class="rounded-xl bg-rose-50 p-4 text-sm text-rose-700"><%= @setting.errors.full_messages.to_sentence %></p>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Monthly requests</p>
      <p class="mt-2 text-3xl font-black"><%= number_with_delimiter(@setting.monthly_requests) %></p>
      <p class="mt-2 text-xs text-slate-500"><%= number_with_delimiter(@setting.estimated_users) %> users × <%= @setting.daily_uses %> uses × 30 days</p>
    </div>
    <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Active model / month</p>
      <p class="mt-2 text-3xl font-black"><%= number_to_currency(@setting.monthly_cost_krw(@setting.model_key), unit: "₩", precision: 0) %></p>
      <p class="mt-2 text-xs text-slate-600"><%= VoiceHelperSetting::MODELS.fetch(@setting.model_key)[:name] %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Lowest estimate / month</p>
      <p class="mt-2 text-3xl font-black"><%= number_to_currency(@setting.monthly_cost_krw(models.first.first), unit: "₩", precision: 0) %></p>
      <p class="mt-2 text-xs text-slate-500"><%= models.first.last[:name] %></p>
    </div>
  </div>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-6 py-5">
        <h2 class="text-lg font-bold">Compare models</h2>
        <p class="mt-1 text-sm text-slate-500">Lowest estimated monthly cost first. Updating usage estimates also updates the order.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs text-slate-500">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">Model</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">Monthly estimate</th>
              <th scope="col" class="px-4 py-3 font-semibold">Selection</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% models.each_with_index do |(key, model), index| %>
              <% active = @setting.model_key == key %>
              <% missing = VoiceHelperSetting.missing_keys(key) %>
              <tr class="<%= active ? 'bg-indigo-50/60' : '' %>">
                <td class="min-w-[220px] px-5 py-5 align-top">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-bold text-slate-950"><%= model[:name] %></span>
                    <% if index.zero? %><span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">Lowest cost</span><% end %>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-slate-500"><%= model[:description] %></p>
                  <p class="mt-2 text-xs <%= missing.empty? ? 'text-emerald-700' : 'text-amber-800' %>"><%= missing.empty? ? "API keys configured" : "Missing: #{missing.join(', ')}" %></p>
                </td>
                <td class="whitespace-nowrap px-4 py-5 align-top">
                  <p class="text-xl font-black"><%= number_to_currency(@setting.monthly_cost_krw(key), unit: "₩", precision: 0) %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= number_to_currency(@setting.monthly_cost_usd(key)) %> / month</p>
                </td>
                <td class="px-4 py-5 align-top">
                  <% if active %>
                    <span class="inline-block rounded-lg bg-indigo-100 px-3 py-2 text-xs font-bold text-indigo-700">Active</span>
                  <% else %>
                    <%= button_to "Use model", admin_voice_helper_setting_path, method: :patch,
                          params: { voice_helper_setting: { model_key: key } },
                          class: "whitespace-nowrap rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="border-t border-slate-200 px-6 py-4 text-xs leading-relaxed text-slate-500">Estimates are for comparison, not actual invoices. Edit the assumptions alongside this table.</p>
    </section>
    <div class="min-w-0 space-y-6">
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="font-bold text-slate-950">Model and API keys</h2>
    <p class="mt-2 text-sm text-slate-600">Choose a model and paste its API key. For Groq + Luna, enter both Groq and OpenAI keys.</p>
    <%= form_with model: @setting, url: admin_voice_helper_setting_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :model_key, "Active model", class: "block text-sm font-semibold" %>
        <%= form.select :model_key, models.map { |key, model| [model[:name], key] }, {}, class: "mt-1 w-full rounded-xl border border-slate-300 p-3 text-sm" %>
      </div>
      <% [:gemini, :openai, :groq].each do |provider| %>
        <% field = "#{provider}_api_key" %>
        <div>
          <%= form.label field, "#{provider == :openai ? 'OpenAI' : provider.to_s.capitalize} API key", class: "block text-sm font-semibold" %>
          <%= form.password_field field, value: "", autocomplete: "new-password", spellcheck: false,
                placeholder: @setting.public_send(field).present? ? "Saved · paste to replace" : "Paste API key",
                class: "mt-1 w-full rounded-xl border border-slate-300 p-3 text-sm" %>
          <p class="mt-1 text-xs text-slate-500"><%= VoiceHelperSetting.api_key(provider).present? ? "Configured" : "Not configured" %></p>
        </div>
      <% end %>
      <%= form.submit "Save model and API keys", class: "w-full cursor-pointer rounded-xl bg-indigo-600 px-4 py-3 text-sm font-bold text-white" %>
    <% end %>
    <p class="mt-3 text-xs leading-relaxed text-slate-500">Keys are encrypted in the database and never shown again. Leave a field blank to keep its saved key. Saved keys take priority over server environment variables and Rails credentials. Key status does not verify provider access or quotas.</p>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="font-bold text-slate-950">Monthly estimate</h2>
    <p class="mt-1 text-sm text-slate-500"><%= number_with_delimiter(@setting.monthly_requests) %> requests over 30 days</p>
    <%= form_with model: @setting, url: admin_voice_helper_setting_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :estimated_users, "Voice helper users per day", class: "block text-sm font-semibold" %>
        <%= form.number_field :estimated_users, min: 1, max: 1_000_000, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 p-3" %>
        <p class="mt-1 text-xs text-slate-500">Unique users who use this feature each day, not total registered users.</p>
      </div>
      <div>
        <%= form.label :daily_uses, "Uses per user per day", class: "block text-sm font-semibold" %>
        <%= form.number_field :daily_uses, min: 1, max: 1_000_000, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 p-3" %>
      </div>
      <div>
        <%= form.label :audio_seconds, "Average recording length (seconds)", class: "block text-sm font-semibold" %>
        <%= form.number_field :audio_seconds, min: 1, max: 30, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 p-3" %>
      </div>
      <div>
        <%= form.label :usd_to_krw, "KRW per USD", class: "block text-sm font-semibold" %>
        <%= form.number_field :usd_to_krw, min: 0.01, max: 100_000, step: 0.01, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 p-3" %>
      </div>
      <%= form.submit "Update estimates", class: "w-full cursor-pointer rounded-xl bg-indigo-600 px-4 py-3 text-sm font-bold text-white" %>
    <% end %>
    <p class="mt-4 text-xs leading-relaxed text-slate-500">Forecast only. Assumes 300 input text tokens and 30 output tokens per request. Excludes thinking tokens, retries, tax, hosting and payment fees. Audio transcription prices may be estimates. Rates checked October 10, 2026; exchange rate is manually editable. These values do not limit user usage.</p>
    <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold text-indigo-600">
      <%= link_to "Google prices", "https://ai.google.dev/gemini-api/docs/pricing" %>
      <%= link_to "OpenAI prices", "https://developers.openai.com/api/docs/pricing" %>
      <%= link_to "Groq prices", "https://console.groq.com/docs/speech-to-text" %>
    </div>
  </section>

    </div>
  </div>
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <header class="mb-5">
      <h2 class="text-lg font-bold">Translation prompt</h2>
      <p class="mt-1 text-sm text-slate-600">Edit how voice recordings are translated. The saved prompt is shared by all models and applies to the next request.</p>
    </header>
    <%= form_with model: @setting, url: admin_voice_helper_setting_path, method: :patch, class: "space-y-4" do |form| %>
      <%= form.label :prompt, "Prompt", class: "block text-sm font-semibold" %>
      <%= form.text_area :prompt, rows: 16, maxlength: 10_000, required: true, spellcheck: false,
            class: "w-full rounded-xl border border-slate-300 bg-slate-50 p-4 font-mono text-sm leading-relaxed" %>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="max-w-3xl text-xs leading-relaxed text-slate-500">Use {{native_language}} and {{native_language_code}} for the user's language. The server enforces a JSON response with one English result; users see only the translation. Estimates assume 300 input text tokens; longer prompts can increase costs.</p>
        <%= form.submit "Save prompt", class: "cursor-pointer rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white" %>
      </div>
    <% end %>
  </section>
</section>
