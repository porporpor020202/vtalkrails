<% content_for :title, "사용자 녹음 · 세이원띵" %>
<section class="admin-page">
  <header class="admin-header"><%= link_to "‹ 사용자 현황", admin_path %><h1>연습 녹음</h1><p><%= @user.email_address %> · 총 <%= @total %>일 연습</p><p>모든 날짜와 시간은 한국 시간입니다.</p></header>
  <div class="admin-recordings">
    <% @practices.each do |practice| %>
      <article class="admin-recording">
        <div class="admin-recording-content">
          <time datetime="<%= practice.completed_at.iso8601 %>"><%= admin_time(practice.completed_at) %> · <%= (practice.duration_ms / 1000.0).round(1) %>초</time>
          <p lang="en"><%= practice.daily_question.question %></p>
        </div>
        <% if practice.audio.attached? %>
          <%= render "shared/recording_player", preview: false, audio_url: audio_admin_user_path(@user, practice_id: practice.id), duration_ms: practice.duration_ms %>
        <% else %>
          <span>녹음 파일 없음</span>
        <% end %>
      </article>
      <% if (bonus = practice.bonus_practice)&.completed? %>
        <article class="admin-recording">
          <div class="admin-recording-content">
            <time datetime="<%= bonus.completed_at.iso8601 %>"><%= admin_time(bonus.completed_at) %> · 공유 보너스 · <%= (bonus.duration_ms / 1000.0).round(1) %>초</time>
            <p lang="en"><%= bonus.question %></p>
          </div>
          <%= render "shared/recording_player", preview: false, audio_url: bonus_audio_admin_user_path(@user, practice_id: bonus.id), duration_ms: bonus.duration_ms %>
        </article>
      <% end %>
    <% end %>
    <% if @practices.empty? %><p class="admin-note">아직 저장된 녹음이 없습니다.</p><% end %>
  </div>
  <section class="admin-section">
    <h2>유입과 사용 기록</h2>
    <p class="admin-note">수집을 시작한 이후의 최근 50개 기록입니다. 같은 방문의 가입 전 행동도 로그인하면 연결됩니다.</p>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>한국 시간</th><th>행동</th><th>당시 상태</th><th>유입 / 글</th></tr></thead><tbody>
      <% @marketing_events.each do |event| %><tr><td><%= admin_time(event.occurred_at) %></td><td><%= marketing_event_label(event.name) %><%= " · 보너스" if event.context == "bonus" %></td><td><%= event.authenticated? ? "로그인" : "비로그인" %></td><td><% if (visit = event.marketing_visit) %><%= marketing_source_label(visit.source) %><small><%= [visit.campaign, visit.content].compact_blank.join(" / ").presence || "글 구분 없음" %></small><% else %>유입 연결 전<% end %></td></tr><% end %>
      <% if @marketing_events.empty? %><tr><td colspan="4">아직 수집된 행동 기록이 없습니다. 과거에 사용하지 않았다는 뜻은 아닙니다.</td></tr><% end %>
    </tbody></table></div>
  </section>
  <nav class="admin-pagination" aria-label="녹음 페이지"><span><%= @page %>페이지</span><% if @page > 1 %><%= link_to "이전", admin_user_path(@user, page: @page - 1) %><% end %><% if @page * 30 < @total %><%= link_to "다음", admin_user_path(@user, page: @page + 1) %><% end %></nav>
</section>
