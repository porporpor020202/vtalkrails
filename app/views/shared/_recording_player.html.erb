<div class="recording-player" data-controller="recording-player">
  <audio hidden preload="none" <%= 'data-daily-practice-target=preview' if preview %> <%= tag.attributes(src: local_assigns.fetch(:audio_url) { audio_daily_practice_path }) unless preview %> data-duration-ms="<%= local_assigns.fetch(:duration_ms) { @practice.duration_ms } unless preview %>" data-recording-player-target="audio" data-action="play->recording-player#update pause->recording-player#update ended->recording-player#update error->recording-player#error timeupdate->recording-player#progress loadedmetadata->recording-player#progress durationchange->recording-player#progress emptied->recording-player#progress"></audio>
  <button type="button" class="play-recording-button" aria-label="녹음 재생" data-recording-player-target="button" data-action="recording-player#toggle">
    <span class="playback-gauge" role="progressbar" aria-label="재생 진행" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-recording-player-target="gauge">
      <svg viewBox="0 0 60 60" fill="none" aria-hidden="true"><circle class="playback-track" cx="30" cy="30" r="27"/><circle class="playback-fill" cx="30" cy="30" r="27" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" data-recording-player-target="ring"/></svg>
    </span>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-recording-player-target="play"><path d="m8 5 11 7-11 7V5Z"/></svg>
    <svg hidden viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-recording-player-target="stop"><path d="M6 6h12v12H6z"/></svg>
  </button>
  <p hidden class="help-error" role="alert" data-recording-player-target="error"></p>
</div>
