<header class="mb-6 flex items-start justify-between gap-3">
  <div class="min-w-0">
    <p class="text-xs font-semibold text-slate-500"><%= selected_language_tab == "mother" ? "Mother Language" : "Learning Language" %></p>
    <h1 class="mt-2 break-words text-3xl font-black tracking-tight text-slate-950"><%= language.name %></h1>
  </div>
  <%= render "shared/conversation_mode", language: language, mode: mode %>
</header>
