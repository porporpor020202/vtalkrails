<% if flash[:reception_notice].present? %>
  <div role="status" data-controller="temporary-notice" data-turbo-temporary class="voice-inbox-notice">
    <%= flash[:reception_notice] %>
  </div>
<% end %>

<% recording = controller_name == "rooms" %>
<section class="voice-inbox-controls" data-controller="<%= recording ? 'voice-recorder' : '' %>" data-voice-recorder-endpoint-value="<%= voice_drop_path %>" data-voice-recorder-max-duration-value="30000">
  <nav class="voice-inbox-toolbar" aria-label="<%= recording ? 'Voice controls' : 'Primary navigation' %>">
    <% unless recording %>
      <span aria-hidden="true"></span>
    <% else %>
    <%= button_to room_reception_path, method: :patch, params: { return_to: "rooms" }, form: { class: "voice-inbox-reception" }, aria: { label: "New voices: #{current_user.receive_new_rooms? ? 'on' : 'off'}", pressed: current_user.receive_new_rooms?.to_s }, class: "voice-inbox-tool #{current_user.receive_new_rooms? ? '' : 'voice-inbox-tool-paused'}" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 10a8 8 0 0 1 16 0v6a3 3 0 0 1-3 3h-2" />
        <rect x="3" y="10" width="4" height="7" rx="2" /><rect x="17" y="10" width="4" height="7" rx="2" />
        <path d="M10 19h3" /><% unless current_user.receive_new_rooms? %><path d="m3 3 18 18" /><% end %>
      </svg>

    <% end %>
    <button type="button" class="voice-inbox-record" data-action="voice-recorder#openSheet" aria-label="Drop a voice"><span class="sr-only">Drop a voice</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-3 0h6" /></svg></button>
    <% end %>
    <div class="voice-inbox-tabs" aria-label="Primary navigation">
      <% if controller_name == "settings" %>
      <%= link_to rooms_path, aria: { label: "Say" }, data: { bottom_nav_target: "link", bottom_nav_tab: "say", turbo_action: "replace" } do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8H5l-3 2 1.5-5A8 8 0 1 1 20 11.5Z" /><path d="M7 10v3m4-5v7m4-5v3" /></svg>
      <% end %>
      <% else %>
      <%= link_to settings_path, aria: { label: "Settings" }, data: { bottom_nav_target: "link", turbo_action: "replace" } do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 17h16" /><circle cx="9" cy="7" r="3" fill="#faf9f6" /><circle cx="15" cy="17" r="3" fill="#faf9f6" /></svg>
      <% end %>
      <% end %>
    </div>
  </nav>
  <%= render "rooms/voice_recorder_sheet" if recording %>
</section>
