<%= form_with model: current_user,
      url: destination,
      method: :patch,
      class: "space-y-4 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm" do |form| %>
  <% if current_user.errors.any? %>
    <p role="alert" class="text-sm text-rose-600">
      <%= current_user.errors.full_messages.to_sentence %>
    </p>
  <% end %>

  <div>
    <%= form.label :native_language, "Native language",
          class: "mb-2 block text-sm font-semibold text-slate-700" %>
    <%= form.select :native_language,
          User::NATIVE_LANGUAGES,
          { include_blank: "Select language" },
          required: true,
          class: "h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-950 focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <%= form.submit submit_label,
        class: "h-12 w-full cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 rounded-xl bg-slate-900 text-sm font-bold text-white transition active:scale-[0.98]" %>
<% end %>
