<% content_for :title, @practice ? t("ui.complete_title") : t("ui.today_title") %>
<% @question_token ||= @question.signed_id(purpose: :daily_question) %>
<% translation_ready = @result&.dig("english").present? %>
<section class="daily-page" data-controller="daily-practice" data-daily-practice-endpoint-value="<%= @recording_endpoint || daily_practice_path %>" data-daily-practice-token-value="<%= @question_token %>" data-action="turbo:before-cache@document->daily-practice#cleanup turbo:frame-load->daily-practice#syncTranslationGate">
  <header class="daily-header">
    <span class="header-date"><%= @today.strftime("%m.%d") %><span><%= t("ui.days")[@today.wday] %></span></span>
    <div class="daily-header-actions">
      <% if @guest %><%= link_to t("ui.login"), new_session_path, class: "header-login", data: { turbo: false } %><% end %>
      <%= link_to settings_path, class: "icon-button", aria: { label: t("ui.settings") } do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3" fill="currentColor"/><circle cx="15" cy="17" r="3" fill="currentColor"/></svg>
      <% end %>
    </div>
  </header>
  <% if @saved %>
    <p class="practice-saved" role="status"><span aria-hidden="true">✓</span> <%= t("ui.saved") %></p>
  <% end %>
  <% if @practice %>
    <%= render "daily_practices/completion" %>
  <% else %>
    <% if @bonus_mode %><%= link_to t("ui.back"), root_path, class: "bonus-back" %><% end %>
    <div class="daily-meta">
      <span><%= @guest ? t("ui.one_day") : (@bonus_mode ? t("ui.bonus_question") : t("ui.trial_progress", current: @trial_used, total: AiUsage::FREE_DAYS)) %></span>
      <% unless @guest %><span class="streak-pill"><%= t("ui.streak", count: @streak) %></span><% end %>
    </div>
    <section class="question-card" aria-labelledby="daily-question">
      <span class="question-label"><span class="question-dot"></span><%= @question.source == 'sample' ? t("ui.sample_question") : t(@bonus_mode ? "ui.bonus_question" : "ui.today_question") %></span>
      <h2 id="daily-question" lang="en"><%= @question.question %></h2>
      <%= turbo_frame_tag "question-translation" do %>
        <%= render "language_helps/question_button" %>
      <% end %>
    </section>
    <div class="language-help" data-controller="language-help" data-language-help-endpoint-value="<%= language_help_path %>" data-language-help-token-value="<%= @question_token %>" data-action="turbo:frame-load->language-help#restoreExample">
      <%= render "language_helps/answer" %>
    </div>
    <div>
      <div>
        <% if @guest || !current_user.daily_practices.exists? %>
          <p class="first-practice-hint" data-daily-practice-target="hint" <%= 'hidden' unless translation_ready %>><%= t("ui.record_hint") %> <span aria-hidden="true">↓</span></p>
        <% end %>
        <p class="recording-status" role="status" aria-live="polite" data-daily-practice-target="status"></p>
        <div class="recording-controls">
          <p class="record-translation-prompt" data-daily-practice-target="translationPrompt" <%= 'hidden' if translation_ready %>><%= t("ui.translate_before_recording") %></p>
          <button type="button" class="record-button" <%= 'hidden disabled' unless translation_ready %> data-action="daily-practice#toggleRecording" data-daily-practice-target="recordButton" aria-label="<%= t("ui.record_start") %>"><svg data-daily-practice-target="micIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-3 0h6"/></svg><span class="stop-icon" hidden data-daily-practice-target="stopIcon"></span></button>
          <span class="record-timer" hidden data-daily-practice-target="timer">00:00</span>
        </div>
        <section class="recording-preview" hidden data-daily-practice-target="previewArea" aria-label="<%= t("ui.record_check") %>">
          <%= render "shared/recording_player", preview: true %>
          <div class="preview-actions"><button type="button" class="secondary-button" data-action="daily-practice#discard" data-daily-practice-target="discardButton"><%= t("ui.record_again") %></button><button type="button" class="primary-button" data-action="daily-practice#submit" data-daily-practice-target="submitButton"><%= t("ui.send") %></button></div>
        </section>
      </div>
    </div>
  <% end %>
</section>
