<%= turbo_frame_tag "question-translation" do %>
  <% if @error %>
    <p class="help-error" role="alert"><%= @error %></p>
    <%= render "language_helps/question_button" %>
  <% else %>
    <details class="question-translation" open><summary><%= t("ui.translation_toggle") %></summary><p lang="<%= I18n.locale %>"><%= @translation %></p></details>
  <% end %>
<% end %>
