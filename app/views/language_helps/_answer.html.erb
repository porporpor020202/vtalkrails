<%= turbo_frame_tag "answer-helper" do %>
  <%= form_with url: language_help_path, class: "answer-help-form" do |form| %>
    <%= form.hidden_field :mode, value: "answer" %>
    <%= form.hidden_field :question_token, value: @question_token || @question&.signed_id(purpose: :daily_question) || params[:question_token] %>
    <%= form.label :input_text, t("ui.input_label") %>
    <%= form.text_area :input_text, value: @input, placeholder: t("ui.input_placeholder"), required: true, maxlength: 300, rows: 3 %>
    <%= form.submit t("ui.translate_answer"), class: "primary-button", data: { turbo_submits_with: t("ui.finding") } %>
  <% end %>
  <% if @error %><p class="help-error" role="alert"><%= @error %></p><% end %>
  <% if @result %>
    <section class="answer-help-result" aria-label="<%= t("ui.answer_label") %>">
      <p class="question-label"><%= t("ui.try_saying") %></p>
      <p class="english-answer" lang="en"><%= @result.fetch("english") %></p>
      <p class="ipa-answer" lang="en" aria-label="<%= t("ui.ipa_label") %>"><%= @result.fetch("ipa") %></p>
    </section>
  <% end %>
<% end %>
