<% content_for :title, "Setting" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <h1 class="mt-2 text-3xl font-black tracking-[-0.035em] text-slate-950">Setting</h1>
  </header>

  <section aria-labelledby="profile-heading">
    <h2 id="profile-heading" class="mb-3 px-1 text-sm font-extrabold tracking-tight text-slate-800">Profile</h2>
    <%= link_to profile_path,
          class: "group block rounded-[28px] transition active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500",
          aria: { label: "Open profile" } do %>
      <%= render "shared/profile_card", user: current_user, navigable: true %>
    <% end %>
  </section>

  <section class="mt-6">
    <h2 class="mb-3 px-1 text-sm font-extrabold text-slate-800">
      Native language
    </h2>

    <%= link_to language_setup_path,
          aria: { label: "Open language settings" },
          class: "group flex items-center gap-4 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm transition active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500" do %>
      <div class="min-w-0 flex-1">
        <div>
          <p class="mb-1 text-xs font-semibold text-slate-500">Native language</p>
          <p class="text-lg font-bold text-slate-950">
            <%= current_user.native_language.label %>
          </p>
        </div>
      </div>

      <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-hover:translate-x-0.5"
           fill="none" viewBox="0 0 24 24" stroke="currentColor"
           aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round"
              stroke-width="2" d="m9 5 7 7-7 7" />
      </svg>
    <% end %>
  </section>
  <section class="mt-6">
    <h2 class="mb-3 px-1 text-sm font-extrabold text-slate-800">Support</h2>
    <%= link_to feedbacks_path, class: "block rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm" do %>
      <span class="block font-bold text-slate-950">Send feedback</span>
      <span class="mt-1 block text-sm text-slate-500">Ask a question or share an idea privately with our team.</span>
    <% end %>
  </section>
</section>
