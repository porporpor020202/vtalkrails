<% content_for :title, t("ui.settings") %>
<section class="simple-page">
  <header class="simple-header"><%= link_to "‹", root_path, aria: { label: t("ui.back_question") } %><h1><%= t("ui.settings") %></h1></header>
  <p class="settings-email"><%= current_user&.email_address %></p>
  <div class="settings-links">
    <%= link_to "#{t("ui.language")}: #{NativeLanguage::OPTIONS.fetch(I18n.locale.to_s)[:name]}", native_language_path %>
    <%= link_to t("ui.privacy"), privacy_path %>
    <% if current_user %>
    <%= button_to t("ui.logout"), session_path, method: :delete %>
    <%= link_to t("ui.delete_account"), confirm_account_deletion_path, class: "danger" %>
    <% end %>
  </div>
</section>
