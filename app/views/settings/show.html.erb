<% content_for :title, "Setting" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <h1 class="mt-2 text-3xl font-black tracking-[-0.035em] text-slate-950">Setting</h1>
  </header>

  <section aria-labelledby="profile-heading">
    <h2 id="profile-heading" class="mb-3 px-1 text-sm font-extrabold tracking-tight text-slate-800">Profile</h2>
    <%= link_to profile_path,
          class: "group block rounded-[28px] transition active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500",
          aria: { label: "Open profile" } do %>
      <%= render "shared/profile_card", user: current_user, navigable: true %>
    <% end %>
  </section>

  <section class="mt-6" aria-labelledby="language-heading">
    <h2 id="language-heading" class="mb-3 px-1 text-sm font-extrabold tracking-tight text-slate-800">Language</h2>

    <%= render "shared/language_form", destination: settings_path, submit_label: "Save" %>
  </section>

  <%= link_to vip_path, class: "mt-6 block rounded-3xl border border-indigo-100 bg-white p-5" do %>
    <span class="font-bold text-indigo-700">VIP · AI English help →</span>
    <p class="mt-1 text-xs text-slate-500"><%= current_user.vip? ? "Your VIP is active" : "Find the words. Keep the conversation going." %></p>
  <% end %>

  <!-- Safety and Support -->
  <section class="mt-6" aria-labelledby="safety-support-heading">
    <h2 id="safety-support-heading" class="mb-3 px-1 text-sm font-extrabold tracking-tight text-slate-800">Safety &amp; Support</h2>
    <div class="overflow-hidden divide-y divide-slate-50 rounded-3xl border border-slate-100 bg-white shadow-sm shadow-slate-100/50">
      <%= link_to support_path, class: "group flex items-center justify-between p-4 transition-colors hover:bg-slate-50/50" do %>
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-500 transition-transform group-hover:scale-105">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m3.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m3.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H15m-6.75 3.75h7.5M21 12c0 4.556-4.03 8.25-9 8.25a9.76 9.76 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.455-.217-.884-.65-1.057C3.312 17.04 2 14.83 2 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-700">Help &amp; Support</p>
            <p class="text-[11px] text-slate-400">Troubleshooting, feedback, and contact</p>
          </div>
        </div>
        <svg class="h-4 w-4 shrink-0 text-slate-300 transition-all group-hover:translate-x-0.5 group-hover:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>

      <a href="mailto:<%= @child_safety_contact_email %>?subject=say%20one%20thing%20child%20safety%20report"
         data-turbo="false"
         class="group flex items-center justify-between p-4 transition-colors hover:bg-rose-50/50"
         aria-label="Report a child safety concern by email">
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-rose-50 text-rose-600 transition-transform group-hover:scale-105">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 4.5h.008v.008H12V16.5z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-700">Report a child safety concern</p>
            <p class="truncate text-[11px] text-slate-400"><%= @child_safety_contact_email %></p>
          </div>
        </div>
        <svg class="h-4 w-4 shrink-0 text-slate-300 transition-all group-hover:translate-x-0.5 group-hover:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <%= link_to child_safety_path, class: "group flex items-center justify-between p-4 transition-colors hover:bg-slate-50/50" do %>
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500 transition-transform group-hover:scale-105">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25L15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751A11.959 11.959 0 0112 2.714z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-700">Child Safety Standards</p>
            <p class="text-[11px] text-slate-400">Read our CSAE prevention and enforcement policy</p>
          </div>
        </div>
        <svg class="h-4 w-4 shrink-0 text-slate-300 transition-all group-hover:translate-x-0.5 group-hover:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </section>

</section>
