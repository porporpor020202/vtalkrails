<% content_for :voice_toolbar, true %>
<% content_for :title, "Settings" %>

<section class="settings-page">
  <header class="settings-header">
    <p>Your space</p>
    <h1>Settings</h1>
  </header>

  <section aria-labelledby="profile-heading">
    <h2 id="profile-heading" class="settings-section-title">Profile</h2>
    <%= link_to profile_path, class: "settings-profile", aria: { label: "Open profile" } do %>
      <div class="settings-avatar" aria-hidden="true">
        <%= image_tag current_user.profile_image_path_for, alt: "", width: 48, height: 48 %>
      </div>
      <div class="settings-profile-details">
        <h3><%= current_user.display_name %></h3>
        <p><%= current_user.email_address %></p>
      </div>
      <svg class="settings-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
    <% end %>
  </section>

  <section class="settings-group" aria-labelledby="preferences-heading">
    <h2 id="preferences-heading" class="settings-section-title">Preferences</h2>
    <%= link_to language_setup_path, class: "settings-row", aria: { label: "Open language settings" } do %>
      <span class="settings-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg></span>
      <span class="settings-row-details"><strong>Native language</strong><span><%= current_user.native_language.label %></span></span>
      <svg class="settings-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
    <% end %>
  </section>

  <section class="settings-group" aria-labelledby="support-heading">
    <h2 id="support-heading" class="settings-section-title">Support</h2>
    <%= link_to feedbacks_path, class: "settings-row" do %>
      <span class="settings-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg></span>
      <span class="settings-row-details"><strong>Send feedback</strong><span>Questions or ideas? Let us know.</span></span>
      <svg class="settings-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
    <% end %>
  </section>
</section>
