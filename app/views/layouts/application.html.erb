<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("ui.today_title") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="<%= t("ui.tagline") %>">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% unless controller_path.start_with?("admin/") || current_user&.marketing_internal? %><meta name="marketing-events-url" content="<%= marketing_events_path %>"><% end %>
    <link rel="icon" href="/say_one_thing_icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/say_one_thing_icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <script type="application/json" id="ui-translations"><%= raw json_escape(t("ui").to_json) %></script>
    <script type="application/json" id="language-selection-translations"><%= raw json_escape(NativeLanguage::OPTIONS.keys.index_with { |locale| I18n.t("ui", locale: locale).slice(:choose_language, :choose_hint, :continue, :existing_account_login) }.to_json) %></script>
    <div id="app-shell" data-controller="marketing" data-action="visibilitychange@document->marketing#resume">
      <% if dev_mode? %><span class="development-badge">DEV</span><% end %>
      <main>
        <% flash.each do |type, message| %>
          <p class="flash" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
