<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for(:title) || "세이원띵 - Say One Thing · 하루 한 문장" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="질문 하나, 영어 한 문장. 매일 짧게 말하고 나만의 연속 기록을 쌓으세요.">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/say_one_thing_icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/say_one_thing_icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div id="app-shell">
      <% if dev_mode? %><span class="development-badge">DEV</span><% end %>
      <main>
        <% flash.each do |type, message| %>
          <p class="flash" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
