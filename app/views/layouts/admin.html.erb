<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Admin" %> · Say One Thing</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-950">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-6 py-5">
        <%= link_to "Say One Thing · Admin", admin_root_path, class: "text-lg font-black" %>
        <%= render "admin/navigation" %>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-2 py-6 sm:px-6">
      <% flash.each do |type, message| %>
        <p role="<%= type == 'alert' ? 'alert' : 'status' %>" class="mb-5 rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
