<% content_for :hide_bottom_nav, true %>
<% content_for :hide_flash, true %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="sign-in-page" data-controller="auth-history" data-action="pageshow@window->auth-history#restore">
  <div class="sign-in-header">
    <img src="/say_one_thing_icon.png" class="sign-in-logo" alt="" width="64" height="64" />
    <h1 class="sign-in-title">Say One Thing</h1>
    <p class="sign-in-description">Sign in to start a conversation.</p>
  </div>

  <% if notice.present? %>
    <div class="sign-in-notice" role="status">
      <svg class="sign-in-notice-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="sign-in-notice sign-in-alert" role="alert">
      <svg class="sign-in-notice-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span><%= alert %></span>
    </div>
  <% end %>

  <div class="sign-in-actions">
    <%= render "shared/sign_in_with_google" %>
    <%= render "shared/sign_in_with_apple" %>
  </div>
</div>
