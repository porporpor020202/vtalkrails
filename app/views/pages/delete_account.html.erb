<% content_for :title, "Account and Data Deletion · say one thing" %>
<% content_for :html_lang, "en" %>
<% @hide_bottom_nav = true %>

<article class="min-h-full bg-slate-50 px-5 pb-16 pt-[max(2rem,env(safe-area-inset-top))] text-slate-700">
  <div class="mx-auto max-w-3xl">
    <header class="border-b border-slate-200 pb-8">
      <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-indigo-600">say one thing</p>
      <h1 class="mt-3 text-4xl font-black tracking-[-0.045em] text-slate-950">Account and Data Deletion</h1>
      <p class="mt-4 text-[15px] leading-7 text-slate-600">
        You can delete your <strong class="font-bold text-slate-950">say one thing</strong> account and associated data,
        provided by <strong class="font-bold text-slate-950"><%= @privacy_operator_name %></strong>, directly on the web.
        You do not need to reinstall or open the app.
      </p>
    </header>

    <section class="mt-8 rounded-[28px] border border-indigo-100 bg-white p-5 shadow-sm" aria-labelledby="deletion-start">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-indigo-600">Delete account</p>
      <h2 id="deletion-start" class="mt-2 text-2xl font-black tracking-tight text-slate-950">Start an account deletion request</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600">
        Verify your identity using the same Google or Apple account you used to create your account.
      </p>
      <%= link_to confirm_account_deletion_path,
            class: "mt-5 flex h-14 w-full items-center justify-center rounded-2xl bg-rose-600 px-5 text-[15px] font-extrabold text-white shadow-lg shadow-rose-200 transition active:scale-[0.98]" do %>
        Start account deletion
      <% end %>
      <p class="mt-3 text-center text-xs leading-5 text-slate-500">Signing in does not delete your account. You will see one final confirmation screen.</p>
    </section>

    <div class="mt-10 space-y-10 text-[15px] leading-7">
      <section aria-labelledby="deletion-steps">
        <h2 id="deletion-steps" class="text-xl font-extrabold tracking-tight text-slate-950">How to delete your account</h2>
        <ol class="mt-4 space-y-4">
          <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-extrabold text-indigo-700">1</span><span>Select <strong class="font-bold text-slate-950">Start account deletion</strong> above.</span></li>
          <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-extrabold text-indigo-700">2</span><span>Choose the sign-in provider you used to register (Google or Apple) and complete authentication.</span></li>
          <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-extrabold text-indigo-700">3</span><span>Confirm the displayed account, then select <strong class="font-bold text-slate-950">Permanently delete account and data</strong>.</span></li>
          <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-extrabold text-indigo-700">4</span><span>You will be signed out when deletion is complete. Deleted accounts and data cannot be recovered.</span></li>
        </ol>
      </section>

      <section aria-labelledby="deleted-data">
        <h2 id="deleted-data" class="text-xl font-extrabold tracking-tight text-slate-950">Data that will be deleted</h2>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <ul class="list-disc space-y-2 pl-5 marker:text-rose-500">
            <li>Account identifiers: email address, sign-in provider, provider user identifier, and internal user ID</li>
            <li>Profile information: generated nickname and icon</li>
            <li>Sign-in sessions, device platform, and push notification tokens</li>
            <li>Matching and conversation room records, sender and recipient relationships, and activity timestamps</li>
            <li>Voice messages and files, recording durations, and sent times</li>
          </ul>
        </div>
        <p class="mt-3 text-sm text-slate-500">This data is deleted with your account when you select the final deletion button.</p>
      </section>

      <section aria-labelledby="retained-data">
        <h2 id="retained-data" class="text-xl font-extrabold tracking-tight text-slate-950">Data retained for an additional period</h2>
        <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-5">
          <ul class="list-disc space-y-2 pl-5 marker:text-amber-600">
            <li>Access, security, and error logs used for service security, fraud prevention, and troubleshooting—including IP address, user agent, and request time—may be retained for <strong class="font-bold text-slate-950">up to 90 days from creation</strong> and then destroyed or de-identified. Voice files are not included in these logs.</li>
            <li>Information that must be retained by law is stored separately for the applicable statutory period and then destroyed.</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="deletion-help">
        <h2 id="deletion-help" class="text-xl font-extrabold tracking-tight text-slate-950">If you cannot sign in or delete your account</h2>
        <p class="mt-3">
          Email our privacy contact at
          <a class="font-semibold text-indigo-700 underline underline-offset-2" href="mailto:<%= @privacy_contact_email %>?subject=say%20one%20thing%20account%20deletion%20request"><%= @privacy_contact_email %></a>
          with the sign-in provider and email address used to register. We will verify your identity before processing the request.
        </p>
      </section>

      <footer class="border-t border-slate-200 pt-6 text-sm text-slate-500">
        For more information about how we process personal information, see our
        <%= link_to "Privacy Policy", privacy_path, class: "font-semibold text-indigo-700 underline underline-offset-2" %>.
      </footer>
    </div>
  </div>
</article>
