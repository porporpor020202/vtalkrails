<% content_for :title, t("ui.delete_account") %>
<section class="simple-page">
  <header class="simple-header"><%= link_to "‹", settings_path, aria: { label: t("ui.back_settings") } %><h1><%= t("ui.delete_account") %></h1></header>
  <p><%= current_user.email_address %></p>
  <p><%= t("ui.delete_warning") %></p>
  <%= button_to t("ui.delete_all"), account_path, method: :delete, class: "primary-button", form: { data: { turbo_confirm: t("ui.delete_confirm") } } %>
  <%= link_to t("ui.cancel"), settings_path, class: "secondary-button" %>
</section>
