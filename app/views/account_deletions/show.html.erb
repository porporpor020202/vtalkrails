<% content_for :title, "Confirm Account Deletion · say one thing" %>
<% content_for :html_lang, "en" %>
<% @hide_bottom_nav = true %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(2rem,env(safe-area-inset-top))] text-slate-700">
  <div class="mx-auto flex w-full max-w-sm flex-1 flex-col">
    <header>
      <%= link_to delete_account_path, class: "inline-flex items-center gap-2 text-sm font-bold text-indigo-700" do %>
        <span aria-hidden="true">←</span> Back to deletion information
      <% end %>
      <p class="mt-8 text-xs font-extrabold uppercase tracking-[0.2em] text-rose-600">Final confirmation</p>
      <h1 class="mt-2 text-3xl font-black tracking-[-0.04em] text-slate-950">Delete this account?</h1>
      <p class="mt-4 text-[15px] leading-7">All data associated with the authenticated account below will be permanently deleted.</p>
    </header>

    <div class="mt-6 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm">
      <dl class="space-y-3 text-sm">
        <div>
          <dt class="font-semibold text-slate-500">Sign-in provider</dt>
          <dd class="mt-1 font-bold text-slate-950"><%= current_user.oauth_provider.to_s.titleize.presence || "say one thing" %></dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-500">Email</dt>
          <dd class="mt-1 break-all font-bold text-slate-950"><%= current_user.email_address.presence || "No email address available" %></dd>
        </div>
      </dl>
    </div>

    <div class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm leading-6 text-rose-900">
      Your account, profile, sessions, push tokens, matching and conversation records, and voice messages and files will be deleted. This action cannot be canceled or undone.
    </div>

    <div class="mt-auto space-y-3 pt-10">
      <%= button_to account_path,
            method: :delete,
            form: { data: { turbo_confirm: "Permanently delete this account and its associated data? This action cannot be undone." } },
            class: "flex h-14 w-full items-center justify-center rounded-2xl bg-rose-600 px-5 text-[15px] font-extrabold text-white shadow-lg shadow-rose-200 transition active:scale-[0.98]" do %>
        Permanently delete account and data
      <% end %>
      <%= link_to "Cancel", root_path, class: "flex h-14 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-[15px] font-bold text-slate-700 transition active:scale-[0.98]" %>
    </div>
  </div>
</section>
