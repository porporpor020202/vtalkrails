<% content_for :voice_toolbar, true %>

<section class="voice-inbox" data-controller="pull-to-refresh">
  <header class="voice-inbox-header">
    <p><span>Language:</span> <strong><%= current_user.native_language.label %></strong></p>
  </header>
  <div class="voice-inbox-refresh" data-pull-to-refresh-target="indicator" role="status"><span data-pull-to-refresh-target="label">Pull to refresh</span></div>
  <%= turbo_frame_tag "room-list", target: "_top", class: "voice-inbox-list", data: { pull_to_refresh_target: "frame" } do %>
    <% if @rooms.any? %>
      <% @rooms.each_with_index do |room, index| %>
        <%= link_to room_path(room), class: "voice-inbox-row" do %>
          <svg class="voice-inbox-avatar" style="color: <%= %w[#9dcb7d #80947d #dca985 #b6a8b8 #9c918c #9da9a8 #b6b5c8 #b89a9a][index % 8] %>" viewBox="0 0 64 56" fill="none" aria-hidden="true">
            <path d="M12 24v8m10-16v24m10-30v36m10-30v24m10-16v8" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          </svg>
          <span class="voice-inbox-name"><%= room.opponent_for(current_user)&.display_name || "Former user" %> <span class="voice-inbox-count"><%= @voice_message_counts.fetch(room.id, 0) %></span></span>
          <% if room.last_voice_message.present? %>
            <time class="voice-inbox-time" datetime="<%= room.last_voice_message.created_at.iso8601 %>"><%= time_ago_in_words(room.last_voice_message.created_at) %></time>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="voice-inbox-empty"><p>Send your voice</p></div>
    <% end %>
  <% end %>
</section>
