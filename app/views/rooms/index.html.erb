<section class="relative flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-36 pt-[max(1.5rem,env(safe-area-inset-top))]" data-controller="pull-to-refresh">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-30 flex h-12 items-center justify-center bg-white/90 text-xs font-bold text-slate-500 shadow-sm transition-transform duration-150" data-pull-to-refresh-target="indicator" aria-hidden="true">
    <span data-pull-to-refresh-target="label">Pull to refresh</span>
  </div>

  <% if @rooms.any? %>
    <div class="space-y-3">
      <% @rooms.each do |room| %>
        <% opponent = room.opponent_for(current_user) %>
        <% last_message = room.voice_messages.last %>
        <%= link_to room_path(room), class: "flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition active:scale-[0.99]" do %>
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-2xl" aria-hidden="true">
            <%= opponent.icon.presence || "💬" %>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-3">
              <h2 class="truncate text-[15px] font-bold text-slate-900"><%= opponent.name.presence || "Voice partner" %></h2>
              <% if last_message %>
                <time class="shrink-0 text-[10px] font-medium text-slate-400"><%= time_ago_in_words(last_message.created_at) %> ago</time>
              <% end %>
            </div>
            <p class="mt-1 text-xs font-medium <%= room.deleted? ? "text-rose-600" : (room.can_reply?(current_user) ? "text-indigo-600" : "text-slate-500") %>">
              <%= room.deleted? ? "#{opponent.name} no longer wants to continue this conversation." : (room.can_reply?(current_user) ? "Your turn to reply" : "Waiting for a reply") %>
            </p>
          </div>
          <svg class="h-5 w-5 shrink-0 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-1 flex-col items-center justify-center rounded-[32px] border border-dashed border-slate-300 bg-white px-8 py-12 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-indigo-50 text-3xl">🎙️</div>
      <h2 class="mt-5 text-lg font-bold text-slate-900">Send your first voice</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Record up to 30 seconds. We will deliver it to a recently active listener.</p>
    </div>
  <% end %>
</section>

<%= render "voice_recorder",
      endpoint: voice_drop_path,
      trigger_classes: "fixed bottom-[calc(5.75rem+env(safe-area-inset-bottom))] left-1/2 z-30 -translate-x-1/2 rounded-full bg-gradient-to-r from-rose-500 to-red-600 px-6 py-3.5 text-sm font-extrabold text-white shadow-xl shadow-rose-500/30 ring-4 ring-white transition active:scale-95" %>
