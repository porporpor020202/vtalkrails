<section class="flex flex-1 flex-col bg-slate-50 px-5 pb-36" data-controller="pull-to-refresh">
  <div class="pointer-events-none flex h-10 items-center justify-center bg-white/90 text-xs font-bold text-slate-500 shadow-sm transition-transform duration-150" data-pull-to-refresh-target="indicator">
    <span data-pull-to-refresh-target="label">Pull to refresh</span>
  </div>

<!--  TODO: 공식문서 확인.-->
  <header class="mt-4 mb-6">
    <%= select_tag :say_language_id,
          options_from_collection_for_select(
            [current_user.learning_language, current_user.native_language],
            :id, :label, current_user.learning_language_id
          ),
          aria: { label: "Language" },
          class: "h-12 w-full rounded-xl border border-slate-300 bg-white px-3 text-base text-slate-950" %>
  </header>

  <% if @rooms.any? %>
    <div class="space-y-3">
      <% @rooms.each do |room| %>
        <% opponent = room.opponent_for(current_user) %>
        <% last_message = room.voice_messages.last %>
        <%= link_to room_path(room), class: "flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition active:scale-[0.99]" do %>
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-2xl" aria-hidden="true">
            <%= image_tag opponent.profile_image_path_for, alt: "", width: 40, height: 40, class: "shrink-0 object-contain", aria: { hidden: true } %>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-3">
              <h2 class="truncate text-[15px] font-bold text-slate-900"><%= opponent.display_name.presence || "Voice partner" %></h2>
              <% if last_message %>
                <time class="shrink-0 text-[10px] font-medium text-slate-400"><%= time_ago_in_words(last_message.created_at) %> ago</time>
              <% end %>
            </div>
            <p class="mt-1 text-xs font-medium <%= room.deleted? ? "text-rose-600" : (room.can_reply?(current_user) ? "text-indigo-600" : "text-slate-500") %>">
              <%= room.deleted? ? "#{opponent.display_name} no longer wants to continue this conversation." : (room.can_reply?(current_user) ? "Your turn to reply" : "Waiting for a reply") %>
            </p>
          </div>
          <svg class="h-5 w-5 shrink-0 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-1 flex-col items-center justify-center rounded-[32px] border border-dashed border-slate-300 bg-white px-8 py-12 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-indigo-50 text-3xl">🎙️</div>
      <h2 class="mt-5 text-lg font-bold text-slate-900">Send your voice</h2>
    </div>
  <% end %>
</section>

<section data-controller="voice-recorder" data-voice-recorder-endpoint-value=<%= voice_drop_path %> data-voice-recorder-max-duration-value="30000">

  <button type="button" class="fixed bottom-25 left-1/2 z-30 -translate-x-1/2 rounded-full bg-gradient-to-r from-rose-500 to-red-600 px-6 py-3.5 text-sm font-extrabold text-white shadow-xl shadow-rose-500/30 ring-4 ring-white" data-action="voice-recorder#openSheet">
    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
      <path d="M12 14a3 3 0 003-3V5a3 3 0 10-6 0v6a3 3 0 003 3z" />
      <path d="M17 11a5 5 0 01-10 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-2z" />
    </svg>
    <span class="sr-only">"Drop a voice"</span>
  </button>

  <%= render "voice_recorder_sheet" %>

</section>
