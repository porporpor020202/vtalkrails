<section class="flex flex-1 flex-col bg-slate-50 px-5 pb-36" data-controller="pull-to-refresh">
  <div class="pointer-events-none flex h-10 items-center justify-center bg-white/90 text-xs font-bold text-slate-500 shadow-sm transition-transform duration-150" data-pull-to-refresh-target="indicator">
    <span data-pull-to-refresh-target="label">Pull to refresh</span>
  </div>

<!--  TODO: 공식문서 확인.-->
  <header class="mt-4 mb-6 flex items-center gap-3">
    <%= form_with url: rooms_path, method: :get,
          data: { controller: "room-filter", action: "change->room-filter#submit", turbo_frame: "room-list" },
          class: "flex w-full items-center gap-3" do %>
      <%= label_tag :room_language_id, "Practice in",
            class: "shrink-0 text-sm font-bold text-slate-600" %>

      <%= select_tag :room_language_id,
            options_from_collection_for_select(@languages, :id, :label, @language.id),
            class: "h-12 min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-3 text-base font-semibold text-slate-950" %>
    <% end %>
  </header>

  <%= turbo_frame_tag "room-list", target: "_top",
        class: "flex flex-1 flex-col" do %>
    <% if @rooms.any? %>
      <div class="space-y-3">
        <% @rooms.each do |room| %>
          <%= link_to room.opponent_for(current_user).display_name, room_path(room),
                class: "block rounded-2xl border border-slate-200 bg-white p-5 font-semibold text-slate-950" %>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-1 flex-col items-center justify-center rounded-[32px] border border-dashed border-slate-300 bg-white px-8 py-12 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-indigo-50 text-3xl">🎙️</div>
        <h2 class="mt-5 text-lg font-bold text-slate-900">Send your voice</h2>
      </div>
    <% end %>
  <% end %>
</section>

<section data-controller="voice-recorder" data-voice-recorder-endpoint-value=<%= voice_drop_path %> data-voice-recorder-max-duration-value="30000">

  <button type="button" class="fixed bottom-[calc(var(--bottom-nav-height,0px)+1rem)] left-1/2 z-30 -translate-x-1/2 rounded-full bg-gradient-to-r from-rose-500 to-red-600 px-6 py-3.5 text-sm font-extrabold text-white shadow-xl shadow-rose-500/30 ring-4 ring-white" data-action="voice-recorder#openSheet">
    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
      <path d="M12 14a3 3 0 003-3V5a3 3 0 10-6 0v6a3 3 0 003 3z" />
      <path d="M17 11a5 5 0 01-10 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-2z" />
    </svg>
    <span class="sr-only">"Drop a voice"</span>
  </button>

  <%= render "voice_recorder_sheet" %>

</section>
