<% content_for :title, "#{(@opponent&.display_name || "Former user")} · say one thing" %>
<% content_for :hide_bottom_nav, true %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50" data-controller="voice-recorder" data-voice-recorder-endpoint-value="<%= room_voice_messages_path(@room) %>" data-voice-recorder-max-duration-value="30000">
  <header class="sticky top-0 z-20 flex shrink-0 items-center gap-3 border-b border-slate-200 bg-white/95 px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] backdrop-blur">
    <%= link_to rooms_path(room_language_id: @room.language_id), class: "flex h-10 w-10 items-center justify-center rounded-full text-slate-600 transition active:bg-slate-100", aria: { label: "Back to rooms" } do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-7 7 7 7" />
      </svg>
    <% end %>
    <%= image_tag (@opponent&.profile_image_path_for || "emoji/animals_and_nature/raccoon_3d.png"), alt: "", width: 32, height: 32, class: "shrink-0 object-contain", aria: { hidden: true } %>
    <div class="min-w-0 flex-1">
      <h1 class="truncate text-[15px] font-extrabold text-slate-950"><%= (@opponent&.display_name || "Former user") %></h1>
      <p class="text-[11px] font-medium text-slate-400">Voice by voice</p>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      <% if @opponent %>
        <%= link_to room_safety_path(@room), title: "Report or block", class: "flex h-11 w-11 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700 transition active:bg-rose-100" do %>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 18h14l-1.5-10A3 3 0 0 0 14.5 5h-5a3 3 0 0 0-3 3L5 18Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 18h16v3H4zM12 1v1M3 4l2 2M21 4l-2 2" />
          </svg>
          <span class="sr-only">Report or block</span>
        <% end %>
      <% end %>
      <%= button_to room_path(@room), method: :delete, form: { data: { turbo_confirm: "Delete this room? This cannot be undone." } }, title: "Delete room", class: "flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 transition active:bg-slate-100" do %>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
        </svg>
        <span class="sr-only">Delete room</span>
      <% end %>
    </div>
  </header>

  <% if @opponent %>
    <div class="flex justify-end gap-2 border-b border-slate-200 bg-white px-4 py-2">
      <%= button_to "Report user", room_safety_path(@room), method: :get,
            class: "rounded-xl bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700" %>
      <%= button_to "Block user", room_block_path(@room), method: :post,
            form: { data: { turbo_confirm: "Block this user and end the conversation?" } },
            class: "rounded-xl border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600" %>
    </div>
  <% end %>

  <div class="flex-1 space-y-5 px-4 py-6 pb-32">
    <% @messages.each do |message| %>
      <% outgoing = message.sender_id == current_user.id %>
      <article class="flex max-w-[88%] items-end gap-2 <%= outgoing ? "ml-auto flex-row-reverse" : "" %>">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl <%= outgoing ? "bg-slate-900 text-[10px] font-black text-white" : "bg-indigo-50 text-base" %>">
          <%= outgoing ? "ME" : image_tag((@opponent&.profile_image_path_for || "emoji/animals_and_nature/raccoon_3d.png"), alt: "", width: 26, height: 26, class: "shrink-0 object-contain", aria: { hidden: true }) %>
        </div>
        <div class="min-w-0 <%= outgoing ? "text-right" : "" %>">
          <div class="rounded-3xl p-3 shadow-sm <%= outgoing ? "bg-gradient-to-br from-indigo-600 to-violet-600" : "border border-slate-200 bg-white" %>">
            <audio controls preload="metadata" controlslist="nodownload" class="h-10 w-[230px] max-w-full" src="<%= audio_room_voice_message_path(@room, message) %>">
              Your browser does not support audio playback.
            </audio>
          </div>
          <p class="mt-1 px-2 text-[10px] font-medium text-slate-400">
            <%= (message.duration_ms / 1000.0).round %>s · <%= message.created_at.strftime("%l:%M %p").strip %>
          </p>
        </div>
      </article>
    <% end %>
  </div>

  <footer class="fixed inset-x-0 bottom-0 z-20 mx-auto w-full max-w-[430px] border-t border-slate-200 bg-white/95 px-5 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur">
    <% if !@room.unavailable?(current_user) && @room.can_reply?(current_user) %>
      <button type="button" data-action="voice-recorder#openSheet" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-rose-500 to-red-600 px-5 py-4 text-sm font-extrabold text-white shadow-lg shadow-rose-500/20 transition active:scale-[0.99]">
        Reply with voice
      </button>
    <% else %>
      <p class="rounded-2xl bg-slate-100 px-5 py-4 text-center text-sm font-semibold text-slate-500">
        You can reply after your partner responds.
      </p>
    <% end %>
  </footer>

  <% if @room.deleted? %>
    <dialog open role="dialog" data-controller="dismiss-dialog">
      <p>Your partner has left the conversation.</p>
      <button data-action="dismiss-dialog#close">OK</button>
    </dialog>
  <% elsif @room.content_reports.where(status: ["pending", "reviewed", "actioned"]).exists? %>
    <dialog open role="dialog" data-controller="dismiss-dialog">
      <p>Your report has been submitted and is under review.</p>
      <button data-action="dismiss-dialog#close">OK</button>
    </dialog>
  <% end %>
  <%= render "voice_recorder_sheet" %>
</section>
