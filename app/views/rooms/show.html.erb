<% content_for :title, "#{(@opponent&.display_name || "Former user")} · say one thing" %>
<% content_for :hide_bottom_nav, true %>

<section class="room-conversation" data-controller="voice-recorder" data-voice-recorder-endpoint-value="<%= room_voice_messages_path(@room) %>" data-voice-recorder-max-duration-value="30000">
  <header class="room-header">
    <%= link_to rooms_path, class: "room-icon-button", aria: { label: "Back to rooms" } do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-7 7 7 7" />
      </svg>
    <% end %>
    <%= image_tag (@opponent&.profile_image_path_for || "emoji/animals_and_nature/raccoon_3d.png"), alt: "", width: 32, height: 32, class: "shrink-0 object-contain", aria: { hidden: true } %>
    <div class="min-w-0 flex-1">
      <h1 class="room-title"><%= (@opponent&.display_name || "Former user") %></h1>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      <% if @opponent %>
        <%= link_to room_safety_path(@room), title: "Report or block", class: "room-icon-button" do %>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 18h14l-1.5-10A3 3 0 0 0 14.5 5h-5a3 3 0 0 0-3 3L5 18Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 18h16v3H4zM12 1v1M3 4l2 2M21 4l-2 2" />
          </svg>
          <span class="sr-only">Report or block</span>
        <% end %>
        <%= button_to room_block_path(@room), method: :post,
              form: { data: { turbo_confirm: "Block this user and end the conversation?" } },
              class: "room-icon-button", title: "Block user", aria: { label: "Block user" } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m6 6 12 12" /></svg>
          <span class="sr-only">Block user</span>
        <% end %>
      <% end %>
      <%= button_to room_path(@room), method: :delete, form: { data: { turbo_confirm: "Delete this room? This cannot be undone." } }, title: "Delete room", class: "room-icon-button" do %>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
        </svg>
        <span class="sr-only">Delete room</span>
      <% end %>
    </div>
  </header>

  <div class="room-messages">
    <% @messages.each do |message| %>
      <% outgoing = message.sender_id == current_user.id %>
      <article class="room-message <%= outgoing ? "room-message-outgoing" : "" %>">
        <div class="room-message-avatar <%= outgoing ? "room-message-me" : "room-message-partner" %>">
          <%= outgoing ? "ME" : image_tag((@opponent&.profile_image_path_for || "emoji/animals_and_nature/raccoon_3d.png"), alt: "", width: 26, height: 26, class: "shrink-0 object-contain", aria: { hidden: true }) %>
        </div>
        <div class="min-w-0 <%= outgoing ? "text-right" : "" %>">
          <div class="room-audio <%= outgoing ? "room-audio-outgoing" : "room-audio-incoming" %>">
            <div class="room-voice" data-controller="audio-playback">
              <audio preload="none" src="<%= audio_room_voice_message_path(@room, message) %>" data-audio-playback-target="audio" data-action="play->audio-playback#update pause->audio-playback#update ended->audio-playback#update"></audio>
              <button type="button" class="room-play" data-audio-playback-target="button" data-action="audio-playback#toggle" aria-label="Play recording">
                <svg data-audio-playback-target="play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
                <svg class="hidden" data-audio-playback-target="pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
              </button>
              <span class="room-voice-duration"><%= (message.duration_ms / 1000.0).round %>s</span>
            </div>
          </div>
          <p class="room-message-time">
            <%= message.created_at.strftime("%l:%M %p").strip %>
          </p>
        </div>
      </article>
    <% end %>
  </div>

  <footer class="room-reply-bar">
    <% if !@room.unavailable?(current_user) && @room.can_reply?(current_user) %>
      <button type="button" data-action="voice-recorder#openSheet" class="settings-button">
        Reply with voice
      </button>
    <% elsif @opponent && @opponent.native_language_id != @room.native_language_id %>
      <p class="room-waiting">Your partner is using another language. You can reply when they return.</p>
    <% else %>
      <p class="room-waiting">
        You can reply after your partner responds.
      </p>
    <% end %>
  </footer>

  <% if @room.deleted? %>
    <dialog open role="dialog" data-controller="dismiss-dialog">
      <p>Your partner has left the conversation.</p>
      <button data-action="dismiss-dialog#close">OK</button>
    </dialog>
  <% elsif @room.content_reports.where(status: ["pending", "reviewed", "actioned"]).exists? %>
    <dialog open role="dialog" data-controller="dismiss-dialog">
      <p>Your report has been submitted and is under review.</p>
      <button data-action="dismiss-dialog#close">OK</button>
    </dialog>
  <% end %>
  <%= render "voice_recorder_sheet" %>
</section>
