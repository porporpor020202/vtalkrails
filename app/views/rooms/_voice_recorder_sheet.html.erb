<div class="hidden recorder-overlay" data-voice-recorder-target="sheet">
  <section class="recorder-sheet" role="dialog" aria-modal="true" aria-labelledby="recorder-title">
    <header class="recorder-header">
      <div><p class="recorder-eyebrow">Your voice</p><h2 id="recorder-title">Record a voice</h2></div>
      <button type="button" class="recorder-close" data-action="voice-recorder#closeSheet" aria-label="Close recorder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </header>
    <p class="recorder-hint">Take a moment. You have 30 seconds.</p>
    <div class="recorder-timer" data-voice-recorder-target="timer">00:00</div>
    <p class="hidden recorder-status" data-voice-recorder-target="recordingMessage" aria-live="polite">Recording…</p>
    <div class="recorder-controls">
      <button type="button" class="recorder-record" data-voice-recorder-target="recordButton" data-action="voice-recorder#startRecording" aria-label="Start recording">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-3 0h6" /></svg>
      </button>
      <button type="button" class="hidden recorder-stop" data-voice-recorder-target="stopButton" data-action="voice-recorder#stopRecording" aria-label="Stop recording">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
      </button>
    </div>
    <div class="hidden recorder-preview" data-voice-recorder-target="previewArea">
      <div class="recorder-playback" data-controller="audio-playback">
        <audio data-audio-playback-target="audio" data-voice-recorder-target="preview" data-action="play->audio-playback#update pause->audio-playback#update ended->audio-playback#update"></audio>
        <button type="button" class="recorder-play" data-audio-playback-target="button" data-action="audio-playback#toggle" aria-label="Play recording">
          <svg data-audio-playback-target="play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
          <svg class="hidden" data-audio-playback-target="pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
        </button>
      </div>
      <div class="recorder-preview-actions">
        <button type="button" class="settings-button recorder-again" data-action="voice-recorder#discard">Record again</button>
        <button type="button" class="settings-button" data-voice-recorder-target="sendButton" data-action="voice-recorder#send">Send voice</button>
      </div>
    </div>
  </section>
</div>
