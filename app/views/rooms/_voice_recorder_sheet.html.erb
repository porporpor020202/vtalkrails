<div class="hidden fixed flex items-end inset-0 z-[100] bg-slate-950/70 p-4 backdrop-blur-sm" data-voice-recorder-target="sheet" data-action="phrase-demo:recording->voice-recorder#stopForHelper">
  <div class="w-full max-h-[85dvh] overflow-y-auto rounded-[32px] bg-white px-6 pb-10 pt-6">

    <div class="flex justify-end">
      <button type="button" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500" data-action="voice-recorder#closeSheet" aria-label="Close recorder">✕</button>
    </div>

    <div class="mt-4" data-controller="phrase-demo" data-phrase-demo-endpoint-value="<%= voice_helper_path %>" data-phrase-demo-speech-endpoint-value="<%= text_to_speech_path %>" data-action="voice-recorder:closed@window->phrase-demo#cancel voice-recorder:recording@window->phrase-demo#cancel">
      <button type="button" data-action="phrase-demo#open" class="flex w-full items-center justify-between rounded-2xl border border-orange-200 bg-orange-50 px-4 py-4 text-left">
        <span><span class="block text-sm font-bold text-slate-900">How do I say this in English?</span></span>
        <span aria-hidden="true" class="text-xl text-orange-600">✦</span>
      </button>
      <div class="hidden mt-3 rounded-2xl bg-slate-950 p-5 text-white" data-phrase-demo-target="prompt">
        <p class="text-xs font-semibold uppercase tracking-widest text-orange-300">Voice helper</p>
        <p class="mt-3 text-lg font-bold">What would you like to say?</p>
        <div class="mt-3 flex justify-end">
          <button type="button" data-action="phrase-demo#openInstructions" aria-haspopup="dialog" class="rounded-full bg-white/10 px-3 py-2 text-xs font-semibold text-orange-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300">How to use</button>
        </div>
        <dialog data-phrase-demo-target="instructions" data-action="click->phrase-demo#closeInstructionsOnBackdrop" aria-labelledby="voice-helper-instructions-title" class="m-auto max-h-[85dvh] w-[calc(100%-2rem)] max-w-sm overflow-y-auto rounded-2xl border border-orange-200 bg-orange-50 p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm">
          <div class="p-5">
            <div class="mb-4 flex items-center justify-between gap-4">
              <h2 id="voice-helper-instructions-title" class="text-lg font-bold">How to use Voice helper</h2>
              <button type="button" data-action="phrase-demo#closeInstructions" aria-label="Close instructions" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-slate-600">✕</button>
            </div>
            <p class="text-base font-bold leading-snug">Speak in your native language.</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">Tap the mic. Ask a question, say a sentence, or use just one word.</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-orange-700">Try these in your language</p>
            <ul class="mt-2 space-y-2 text-sm leading-relaxed">
              <li class="rounded-xl bg-white p-3">
                <span class="block text-xs font-bold text-orange-700">A question</span>
                <span class="mt-1 block">“How do I say I have to go to a wedding?”</span>
              </li>
              <li class="rounded-xl bg-white p-3">
                <span class="block text-xs font-bold text-orange-700">A sentence</span>
                <span class="mt-1 block">“I have to go to a wedding.”</span>
              </li>
              <li class="rounded-xl bg-white p-3">
                <span class="block text-xs font-bold text-orange-700">Just a word</span>
                <span class="mt-1 block">“Wedding.”</span>
              </li>
            </ul>
            <p class="mt-4 border-t border-orange-200 pt-3 text-sm font-semibold text-orange-800">Get just the English words you need.</p>
          </div>
        </dialog>
        <button type="button" data-phrase-demo-target="microphone" data-action="phrase-demo#toggleRecording" class="mx-auto my-5 flex h-16 w-16 items-center justify-center rounded-full bg-orange-500 text-3xl disabled:opacity-50" aria-label="Start voice helper">🎙</button>
        <p data-phrase-demo-target="status" role="status" aria-live="polite" class="text-center text-sm leading-relaxed text-slate-300">Tap the mic to start. Tap again to translate.</p>
      </div>
      <div class="hidden mt-3 rounded-2xl border border-orange-200 bg-orange-50 p-5" data-phrase-demo-target="result" role="status">
        <div class="flex items-center justify-end"><button type="button" data-action="phrase-demo#open" class="text-xs font-semibold text-slate-500">Try another</button></div>
        <p data-phrase-demo-target="english" class="mt-3 select-text text-2xl font-bold leading-snug text-slate-950"></p>
        <button type="button" data-phrase-demo-target="listen" data-action="phrase-demo#listen" aria-label="Read English aloud" class="mt-4 inline-flex items-center justify-center rounded-full bg-orange-500 px-4 py-2 text-sm font-bold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600">▶ Listen</button>
        <audio controls preload="none" data-phrase-demo-target="playback" data-action="play->phrase-demo#playbackStarted pause->phrase-demo#resetListen ended->phrase-demo#resetListen error->phrase-demo#playbackFailed" class="hidden mt-3 w-full"></audio>
        <p class="mt-2 text-xs text-slate-500">AI-generated voice</p>
        <p data-phrase-demo-target="playbackStatus" role="status" aria-live="polite" class="mt-2 text-sm text-slate-600"></p>
      </div>
    </div>

    <div class="my-8 text-center">
      <div class="text-5xl font-black text-slate-950" data-voice-recorder-target="timer">00:00</div>
    </div>

    <div data-voice-recorder-target="recordingMessage" class="hidden text-center pb-6 text-bold text-xl">
      <span>Recording…</span>
    </div>

    <div class="flex justify-center">

<!--      녹음 버튼-->
      <button type="button" class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-rose-500 to-red-600 text-white shadow-xl shadow-rose-500/30 ring-8 ring-rose-100" data-voice-recorder-target="recordButton" data-action="voice-recorder#startRecording" aria-label="Start recording">
        <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" /></svg>
      </button>

<!--      정지 버튼-->
      <button type="button" class="hidden h-24 w-24 items-center justify-center rounded-full bg-slate-950 text-white shadow-xl ring-8 ring-slate-200" data-voice-recorder-target="stopButton" data-action="voice-recorder#stopRecording" aria-label="Stop recording">
        <svg class="h-9 w-9 fill-current" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
      </button>
    </div>

    <div class="mt-8 hidden" data-voice-recorder-target="previewArea">
      <audio controls class="w-full" data-voice-recorder-target="preview"></audio>
      <div class="mt-5 grid grid-cols-2 gap-3">
        <button type="button" class="rounded-2xl bg-slate-100 px-4 py-4 text-sm font-extrabold text-slate-600" data-action="voice-recorder#discard">Record again</button>
        <button type="button" class="rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-4 text-sm font-extrabold text-white shadow-lg shadow-indigo-500/20" data-voice-recorder-target="sendButton" data-action="voice-recorder#send">Send voice</button>
      </div>
    </div>

  </div>
</div>
