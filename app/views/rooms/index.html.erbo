<div class="flex-1 flex flex-col h-full bg-slate-50">
  <!-- Room Selection Tabs -->
  <section class="flex-1 overflow-y-auto p-4 space-y-2 bg-slate-50" id="rooms-list">
    <% @rooms.each_with_index do |room, index| %>
      <% if room.your_turn? %>
        <button onclick="location.href='/rooms/<%= room.id %>'" class="room-btn w-full flex items-center gap-4 p-4 rounded-2xl transition-all duration-200 text-left bg-gradient-to-r from-indigo-50 to-violet-50/50 border border-indigo-100/80 shadow-sm shadow-indigo-100/20 <%= 'active-room' if index == 0 %>">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr <%= room_gradient_class(room, index) %> flex items-center justify-center text-2xl shadow-md">
            <%= room.opponent.icon %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-center">
              <span class="font-semibold text-slate-800"><%= room.opponent.name %></span>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-slate-400"><%= short_time_ago(room.updated_at) %></span>
                <span class="text-[10px] text-emerald-600 font-semibold bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100/80">Your Turn</span>
              </div>
            </div>
          </div>
        </button>
      <% elsif room.waiting? %>
        <button onclick="location.href='/rooms/<%= room.id %>'" class="room-btn w-full flex items-center gap-4 p-4 rounded-2xl transition-all duration-200 text-left hover:bg-slate-50 border border-transparent">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr <%= room_gradient_class(room, index) %> flex items-center justify-center text-2xl shadow-md">
            <%= room.opponent.icon %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-center">
              <span class="font-semibold text-slate-700"><%= room.opponent.name %></span>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-slate-400"><%= short_time_ago(room.updated_at) %></span>
                <span class="text-[10px] text-slate-400 font-medium bg-slate-100/80 px-2 py-0.5 rounded-full">Waiting</span>
              </div>
            </div>
          </div>
        </button>
      <% elsif room.deleted? %>
        <button class="room-btn w-full flex items-center gap-4 p-4 rounded-2xl transition-all duration-200 text-left border border-transparent opacity-60 cursor-not-allowed">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr <%= room_gradient_class(room, index) %> flex items-center justify-center text-2xl shadow-md grayscale">
            <%= room.opponent.icon %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-center">
              <span class="font-semibold text-slate-500 line-through"><%= room.opponent.name %></span>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-slate-400"><%= short_time_ago(room.updated_at) %></span>
                <span class="text-[10px] text-rose-500 font-semibold bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-100/50">Deleted</span>
              </div>
            </div>
          </div>
        </button>
      <% end %>
    <% end %>
  </section>

  <section class="relative flex items-center justify-center bg-gradient-to-t from-rose-200 via-rose-100 to-rose-50 rounded-t-3xl" style="height: 88px;">
    <!-- 녹음 버튼 -->
    <button
      id="record-btn"
      class="w-16 h-16 rounded-full flex items-center justify-center shadow-xl shadow-rose-400/50 active:scale-90 transition-transform duration-150"
      style="background: linear-gradient(135deg, #fb7185 0%, #f43f5e 60%, #e11d48 100%);"
      aria-label="녹음 시작"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
      </svg>
    </button>
  </section>
</div>

