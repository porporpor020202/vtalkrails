<% content_for :title, "Profile" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <h1 class="mt-2 text-3xl font-black tracking-[-0.035em] text-slate-950">Profile</h1>
  </header>

  <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-700 text-2xl shadow-lg shadow-indigo-200" aria-hidden="true">
        <%= profile_icon_tag(current_user, size: 44) %>
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="truncate text-base font-bold text-slate-950"><%= current_user.display_name.presence || "say one thing member" %></h2>
        <p class="mt-1 truncate text-sm text-slate-500"><%= current_user.email_address %></p>
      </div>
    </div>
  </div>

  <div class="mt-auto space-y-3 pt-8">
    <%= button_to session_path,
          method: :delete,
          class: "flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-slate-900 text-[15px] font-bold text-white transition active:scale-[0.98]" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Sign Out
    <% end %>

    <%= button_to account_path,
          method: :delete,
          form: { data: { turbo_confirm: "Delete your account permanently? This cannot be undone." } },
          class: "flex h-14 w-full items-center justify-center gap-2 rounded-2xl border border-rose-200 bg-white text-[15px] font-bold text-rose-600 transition active:scale-[0.98]" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-9 0h12" />
      </svg>
      Delete Account
    <% end %>
  </div>
</section>
