<% content_for :title, "Profile" %>

<section class="settings-page settings-detail">
  <header class="settings-header">
    <p>Your space</p>
    <h1>Profile</h1>
  </header>

  <div class="settings-profile-summary">
    <%= image_tag current_user.profile_image_path_for,
          alt: "My profile", width: 96, height: 96,
          class: "settings-profile-photo" %>
    <h2 class="settings-profile-name">
      <%= current_user.display_name %>
    </h2>
    <p class="settings-copy settings-break">
      <%= current_user.email_address %>
    </p>
    <p class="settings-copy">
      Signed in with <%= current_user.oauth_provider.titleize %>
    </p>
  </div>

  <div class="settings-account-actions">
    <%= button_to session_path,
          method: :delete,
          class: "settings-button" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Sign Out
    <% end %>

    <%= button_to account_path,
          method: :delete,
          form: { data: { turbo_confirm: "Delete your account permanently? This cannot be undone." } },
          class: "settings-button settings-button-danger" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-9 0h12" />
      </svg>
      Delete Account
    <% end %>
  </div>
</section>
