<% content_for :title, "#{@language.name} Community" %>
<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <%= render "shared/language_header", language: @language, mode: :community %>

  <%= form_with model: @post, url: language_posts_path(@language, tab: selected_language_tab), class: "mb-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm" do |form| %>
    <%= form.label :body, "Write a post", class: "mb-3 block text-sm font-bold text-slate-950" %>
    <% if @post.errors.any? %>
      <p role="alert" class="mb-3 text-sm text-rose-600"><%= @post.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form.text_area :body, rows: 4, maxlength: 2000, required: true, placeholder: "Share a thought or ask a question…",
          class: "w-full resize-y rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm focus:border-indigo-500 focus:ring-indigo-500", aria: { describedby: "post-limit" } %>
    <div class="mt-3 flex items-center justify-between gap-3">
      <p id="post-limit" class="text-xs text-slate-400">Up to 2,000 characters</p>
      <%= form.submit "Post", class: "cursor-pointer rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white", data: { turbo_submits_with: "Posting…" } %>
    </div>
  <% end %>

  <h2 class="mb-3 px-1 text-sm font-extrabold text-slate-800">Latest posts</h2>
  <div class="space-y-4">
    <%= render partial: "posts/post", collection: @posts, locals: { preview: true } %>
    <% if @posts.empty? %>
      <p class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500">No posts yet. Start a conversation in <%= @language.name %>.</p>
    <% end %>
  </div>
  <% if @more_posts %>
    <%= link_to "Older posts", language_posts_path(@language, tab: selected_language_tab, before: @posts.last.id), class: "mt-5 rounded-xl bg-white py-3 text-center text-sm font-bold text-indigo-600" %>
  <% end %>
</section>
