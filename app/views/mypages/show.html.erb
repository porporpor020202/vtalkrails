<% content_for :title, "My Page · say one thing" %>

<section class="flex min-h-full flex-1 flex-col bg-slate-50 px-5 pb-8 pt-[max(1.5rem,env(safe-area-inset-top))]">
  <header class="mb-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-600">Account</p>
    <h1 class="mt-2 text-3xl font-black tracking-[-0.035em] text-slate-950">My Page</h1>
  </header>

  <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-700 text-2xl shadow-lg shadow-indigo-200" aria-hidden="true">
        <%= current_user.icon.presence || "🙂" %>
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="truncate text-base font-bold text-slate-950"><%= current_user.name.presence || "say one thing member" %></h2>
        <p class="mt-1 truncate text-sm text-slate-500"><%= current_user.email_address %></p>
      </div>
    </div>
  </div>

  <div class="mt-5 overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-4 p-5">
      <div class="flex min-w-0 items-center gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </div>
        <div>
          <p class="text-[15px] font-bold text-slate-900">Autoplay</p>
          <p class="mt-1 text-xs text-slate-500">Coming soon</p>
        </div>
      </div>
      <div class="relative h-7 w-12 shrink-0 rounded-full bg-slate-200" aria-label="Autoplay is not available yet" role="img">
        <span class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow-sm"></span>
      </div>
    </div>
  </div>

  <div class="mt-auto space-y-3 pt-8">
    <%= button_to session_path,
          method: :delete,
          class: "flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-slate-900 text-[15px] font-bold text-white transition active:scale-[0.98]" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Sign Out
    <% end %>

    <%= button_to account_path,
          method: :delete,
          form: { data: { turbo_confirm: "Delete your account permanently? This cannot be undone." } },
          class: "flex h-14 w-full items-center justify-center gap-2 rounded-2xl border border-rose-200 bg-white text-[15px] font-bold text-rose-600 transition active:scale-[0.98]" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-9 0h12" />
      </svg>
      Delete Account
    <% end %>
  </div>
</section>
